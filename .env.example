# Ask command role restriction (comma-separated Discord role IDs)
ASK_ALLOWED_ROLE_IDS=role_id_1,role_id_2

# Ask endpoint shared secret (dashboard + bot must match)
ASK_API_SECRET=your_random_secret_here

# Ticket system (optional)
DEV_TEAM_ROLE_ID=your_dev_team_role_id_here
SERVER_MODERATOR_ID=your_moderator_role_id_here
TICKET_LOG_CHANNEL_ID=your_ticket_log_channel_id_here
