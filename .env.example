DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
GAME_API_URL=https://www.ahousedividedgame.com/
GAME_API_KEY=your_api_key_here

# Server configuration
WELCOME_CHANNEL_ID=your_welcome_channel_id_here
RULES_CHANNEL_ID=your_rules_channel_id_here
MEMBER_ROLE_ID=your_member_role_id_here
ALPHA_TESTER_ROLE_ID=your_alpha_tester_role_id_here
CEO_ROLE_ID=your_ceo_role_id_here
INVESTOR_ROLE_ID=your_investor_role_id_here
INVESTOR_RANK_1_ROLE_ID=your_1_investor_role_id_here
INVESTOR_RANK_2_ROLE_ID=your_2_investor_role_id_here
INVESTOR_RANK_3_ROLE_ID=your_3_investor_role_id_here

# Supporter roles
SUPPORTER_ROLE_ID=your_supporter_role_id_here
SUPPORTER_PLUS_ROLE_ID=your_supporter_plus_role_id_here

# Office roles (assigned by existing role ID — renamed in Discord)
HEAD_OF_GOV_ROLE_ID=your_head_of_gov_role_id_here
